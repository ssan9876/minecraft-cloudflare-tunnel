# Copy to .env and fill in.

# Bundled cloudflared connector: set COMPOSE_PROFILES=tunnel and paste the token from
# Cloudflare Zero Trust > Networks > Tunnels > (your tunnel) > Install connector.
# Leave both empty when an existing cloudflared elsewhere routes to this server.
COMPOSE_PROFILES=
TUNNEL_TOKEN=

# 127.0.0.1 (default) or 0.0.0.0 to accept LAN connections (needed for an external connector)
MC_BIND=127.0.0.1

# Comma-separated Minecraft usernames
MC_WHITELIST=
MC_OPS=

# Web admin panel (http://<host>:8080). ADMIN_BIND=0.0.0.0 to open it to the LAN.
ADMIN_PASSWORD=
ADMIN_BIND=127.0.0.1
PUBLIC_ADDRESS=
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# Server list description
MC_MOTD=Minecraft via Cloudflare Tunnel
MC_VERSION=LATEST
# PAPER (plugins) or FABRIC (mods). With FABRIC, pin MC_VERSION to the version your mods target,
# and put mod jars in ./mods or list Modrinth projects (comma-separated slugs) below.
MC_TYPE=PAPER
MC_MODRINTH_PROJECTS=
MC_REMOVE_OLD_MODS=FALSE
MC_MEMORY=4G
TZ=UTC
