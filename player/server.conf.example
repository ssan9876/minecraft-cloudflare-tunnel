# Copy to server.conf, fill in, then send the whole player folder to your players.

# Public hostname of the TCP route on your Cloudflare tunnel
HOSTNAME=mc.example.com
# Name shown in the players' Multiplayer list
SERVER_NAME=Minecraft Server
# Local port the join script listens on (change if 25565 is taken on the player's PC)
LOCAL_PORT=25565
# Fabric servers only: the mods players need, as an https:// link to a list (so you can update mods
# without sending out new scripts) or a list file next to this script. See mods.txt.example.
# The join script installs Fabric and these mods into a separate launcher installation named SERVER_NAME.
MODS=
