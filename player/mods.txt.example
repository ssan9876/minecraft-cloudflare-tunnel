# The mods players need to join a Fabric server. Point MODS in server.conf at this file (or at a copy
# online), and keep it in step with the server: the same Minecraft and Fabric Loader versions, same mods.
minecraft 26.3
fabric-loader 0.20.1
# One line per mod: a download link, or a jar next to this file
mod https://cdn.modrinth.com/data/P7dR8mSH/versions/EQKgpeKu/fabric-api-0.165.0%2B26.3.jar
